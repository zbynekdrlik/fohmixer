__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.env
*.env.local
.DS_Store

# MCP client config (symlink with auth headers) — never commit
.mcp.json

# Rust build output and the UI bundle (Trunk writes it; CI builds it)
target/
crates/fohmixer-ui/dist/
# tauri-build's generated capability schemas (the tray, #39; iemmixer ignores its own)
crates/fohmixer-tray/gen/
# Playwright
e2e/node_modules/
e2e/playwright-report/
e2e/test-results/
# The Playwright MCP server's page snapshots and screenshots (one was committed by accident, #43)
.playwright-mcp/
# cargo-mutants output
mutants.out/
mutants.out.old/
# Harness-local Claude Code settings and in-session worker worktrees
.claude/settings.local.json
.claude/worktrees/
# Secrets and keys never enter this public repo (spec §5.2)
TARGETS.md
credentials.json
*.pem
*.key
# The FohMixer LUFS device is built from its .maxpat (live-device/*/build_amxd.py) and never
# committed: a frozen device can embed file paths (spec §4.2, public-repo hygiene)
*.amxd
